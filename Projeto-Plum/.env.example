DATABASE_URL=postgresql://usuario:senha@localhost:5432/database

# Gemini
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
# Tempo máximo de espera por resposta do Gemini (ms)
GEMINI_TIMEOUT_MS=60000

# Remoção de fundo (rembg)
# Outras opções: isnet-general-use, u2net, birefnet-general
REMBG_MODEL=u2net
# Refina bordas (mais lento); útil para tecidos felpudos
REMBG_ALPHA_MATTING=false
# Tratamento da máscara (0-255): abaixo do PISO = fundo, acima do TETO = peça sólida.
# Diminua o TETO se partes da peça (ex.: áreas brancas) ficarem transparentes.
REMBG_ALPHA_PISO=20
REMBG_ALPHA_TETO=100
# Buracos internos até essa fração da área da peça são preenchidos
REMBG_MAX_BURACO=0.2
# Precisão do recorte (ver README). Histerese: área "em dúvida" CONECTADA a uma
# região segura vira sólida (recupera partes brancas). BAIXO = valor mínimo (0-255);
# RAIO_PCT = quanto a peça pode "crescer" para fora (% do menor lado da foto)
REMBG_HISTERESE=true
REMBG_HISTERESE_BAIXO=12
REMBG_HISTERESE_RAIO_PCT=3
# Fecha entalhes estreitos na borda (% do menor lado; 0 desliga)
REMBG_FECHAMENTO_PCT=1.5
# Mantém detalhes pequenos PERTO da peça (cadarço, etiqueta); 0 = regra antiga
REMBG_ILHAS_PERTO_PCT=4
# Experimentos (desligados): média com a foto espelhada (2x o tempo do modelo)
# e foto completada para quadrado antes do modelo
REMBG_TTA=false
REMBG_PAD_QUADRADO=false
# Salva original, máscaras e resultado em debug_rembg/ (só para testes)
REMBG_DEBUG=false
# Quantas remoções de fundo rodam ao mesmo tempo (<= nº de núcleos da CPU)
REMBG_MAX_CONCORRENCIA=1
# Núcleos por remoção de fundo (vazio = todos). No servidor: nº de vCPUs
REMBG_THREADS=
# Fila da remoção de fundo: máximo de pedidos aguardando e espera máxima (s)
FILA_MAX_TAMANHO=10
FILA_MAX_ESPERA_S=30

# Imagens
UPLOAD_MAX_MB=15
IMAGEM_LADO_MAX_ENTRADA=1500
IMAGEM_LADO_SAIDA=1024
# Minutos que um recorte aguardando aprovação fica guardado
PREVIEW_TTL_MIN=30

# E-mail (Gmail com "senha de app"; NUNCA versionar a senha real)
EMAIL_REMETENTE=plum.app.tcc@gmail.com
EMAIL_SENHA_APP=sua_senha_de_app_16_letras
EMAIL_NOME=PLUM
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORTA=587
# Código de verificação: validade (min), tentativas, intervalo entre envios (s)
CODIGO_EMAIL_VALIDADE_MIN=10
CODIGO_EMAIL_MAX_TENTATIVAS=5
CODIGO_EMAIL_INTERVALO_S=60

# Servidor (backend)
# IP deste computador na rede (ipconfig -> Endereço IPv4). Usado para montar
# as URLs das imagens: precisa ser o MESMO IP do EXPO_PUBLIC_SERVER_IP do app.
SERVER_IP=SEU_IP_LOCAL
APP_PORT=8000

# Aplicação
EXPO_PUBLIC_SERVER_IP=SEU_IP_LOCAL
EXPO_PUBLIC_PORT=8000
